<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <SolidColorBrush x:Key="BgBrush">#0F1418</SolidColorBrush>
    <SolidColorBrush x:Key="PanelBrush">#182128</SolidColorBrush>
    <SolidColorBrush x:Key="BorderSoftBrush">#222E37</SolidColorBrush>
    <SolidColorBrush x:Key="TextPrimaryBrush">#EDF5F7</SolidColorBrush>
    <SolidColorBrush x:Key="TextSecondaryBrush">#A8B8BF</SolidColorBrush>
    <SolidColorBrush x:Key="TextMutedBrush">#7F9199</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBrush">#2FD4C4</SolidColorBrush>
    <SolidColorBrush x:Key="LimeBrush">#A6E22E</SolidColorBrush>
    <SolidColorBrush x:Key="AmberBrush">#E8B04B</SolidColorBrush>
    <SolidColorBrush x:Key="RedBrush">#F06A6A</SolidColorBrush>
  </Styles.Resources>
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource BgBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="20" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="#071416" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="16,9" />
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="#1D2830" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="#2A3742" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="14,8" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="9,6" />
  </Style>
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected">
    <Setter Property="Background" Value="#173033" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="ListBox.chips ListBoxItem">
    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
    <Setter Property="Padding" Value="11,6" />
    <Setter Property="Margin" Value="0,0,7,7" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="#162026" />
    <Setter Property="BorderBrush" Value="#222E37" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ListBox.chips ListBoxItem:selected">
    <Setter Property="Background" Value="#183638" />
    <Setter Property="BorderBrush" Value="#1BA99C" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="27" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Height" Value="5" />
  </Style>
</Styles>

