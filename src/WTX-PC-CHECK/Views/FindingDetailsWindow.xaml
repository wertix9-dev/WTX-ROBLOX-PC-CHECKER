<Window x:Class="WtxPcCheck.Views.FindingDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WTX PC CHECK · Finding details"
        Width="840" Height="720" MinWidth="680" MinHeight="400"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Background="{StaticResource BgElevatedBrush}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="9" Background="#172B2E" BorderBrush="#275854" BorderThickness="1">
                    <Path Data="M12,2 L20,5 V11 C20,16 16.5,20 12,22 C7.5,20 4,16 4,11 V5 Z M8,12 L11,15 L16,9" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Margin="9" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Finding details" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="WTX PC CHECK · Made by WERTIX" Style="{StaticResource SmallText}" Margin="0,1,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource DangerCloseButton}" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close finding details">
                    <Path Data="M4,4 L14,14 M14,4 L4,14" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="17" Height="17" Stretch="Uniform" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" Style="{StaticResource PageScroll}">
                <StackPanel>
                    <Border Style="{StaticResource InnerPanel}" Margin="0,0,0,16" Background="#1D1B14" BorderBrush="#4A3C1F">
                        <StackPanel>
                            <TextBlock Text="Review, do not assume" Style="{StaticResource CardTitle}" Foreground="{StaticResource AmberBrush}" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource SmallText}" TextWrapping="Wrap"
                                       Text="This is a local indicator, not proof of malware. WTX PC CHECK did not execute, change, delete, move, or quarantine this file. Verify the publisher and the detection limits before deciding what to do." />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding FileName}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBox Text="{Binding FullPath, Mode=OneWay}" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0"
                             Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                             TextWrapping="Wrap" Margin="0,6,0,10" AutomationProperties.Name="Full file path" />

                    <WrapPanel Margin="0,0,0,16">
                        <Border Style="{StaticResource Badge}" Background="{Binding Risk, Converter={StaticResource RiskToBrush}, ConverterParameter=soft}" BorderBrush="{Binding Risk, Converter={StaticResource RiskToBrush}}" BorderThickness="1" Margin="0,0,8,0">
                            <TextBlock Text="{Binding RiskLabel}" Foreground="{Binding Risk, Converter={StaticResource RiskToBrush}}" FontWeight="SemiBold" FontSize="11" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="#142A2D" BorderBrush="#275854" BorderThickness="1" Margin="0,0,8,4">
                            <TextBlock Text="{Binding ClassificationLabel}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="#172126" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" Margin="0,0,8,4">
                            <TextBlock Text="{Binding ConfidenceLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="#172126" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" Margin="0,0,8,4">
                            <TextBlock Text="{Binding CategoryLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="#172126" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" Margin="0,0,0,4">
                            <TextBlock Text="{Binding FileType}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                        </Border>
                    </WrapPanel>

                    <UniformGrid Columns="3" Margin="0,0,0,16">
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="FILE SIZE" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource BodyText}" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="MODIFIED" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding ModifiedText}" Style="{StaticResource BodyText}" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="MATCHED RULE" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding MatchedRule, TargetNullValue=Not available}" Style="{StaticResource BodyText}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </UniformGrid>

                    <Border Style="{StaticResource Divider}" />
                    <TextBlock Text="Why it was flagged" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource BodyText}" Margin="0,0,0,14" />

                    <TextBlock Text="Evidence" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding Evidence}" Style="{StaticResource BodyText}" Margin="0,0,0,14" />

                    <TextBlock Text="Detection method" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding DetectionMethod}" Style="{StaticResource BodyText}" Margin="0,0,0,14" />

                    <TextBlock Text="Limitations" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding Limitations}" Style="{StaticResource BodyText}" Margin="0,0,0,14" />

                    <Border Style="{StaticResource Divider}" />
                    <TextBlock Text="File fingerprint" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                    <TextBlock Text="SHA-256" Style="{StaticResource LabelText}" />
                    <TextBox Text="{Binding Sha256, Mode=OneWay, TargetNullValue=Not computed}" IsReadOnly="True" Style="{StaticResource CodeBox}"
                             MinHeight="52" MaxHeight="90" Margin="0,5,0,4" AutomationProperties.Name="SHA-256 hash" />
                    <TextBlock Text="{Binding HashNote}" Style="{StaticResource SmallText}" Margin="0,0,0,14" Visibility="{Binding HashNote, Converter={StaticResource StringToVisibility}}" />

                    <TextBlock Text="Digital signature" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                    <Border Style="{StaticResource InnerPanel}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding Signature.StatusText}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding Signature.PublisherDisplay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Signature.Detail}" Style="{StaticResource SmallText}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Signature.ThumbprintSha256}" Style="{StaticResource MonoText}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="{Binding Signature.ThumbprintSha256, Converter={StaticResource StringToVisibility}}" />
                            <TextBlock Text="{Binding Signature.ValidityDisplay}" Style="{StaticResource SmallText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Visibility="{Binding IsScriptFile, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource Divider}" />
                        <TextBlock Text="Safe script preview" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource SmallText}" Margin="0,0,0,10"
                                   Text="The script is shown as read-only static text. WTX PC CHECK never executes a discovered script. Opening or running it yourself can be dangerous." />
                        <CheckBox x:Name="PreviewConfirm" Content="I understand and want to view the script as static text" Margin="0,0,0,10" />
                        <Button x:Name="LoadPreviewButton" Content="Load safe text preview" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" IsEnabled="{Binding IsChecked, ElementName=PreviewConfirm}" Click="LoadPreview_Click" />
                        <TextBlock x:Name="PreviewNote" Style="{StaticResource SmallText}" Margin="0,8,0,6" />
                        <TextBox x:Name="PreviewBox" Style="{StaticResource CodeBox}" Height="240" Visibility="Collapsed" AutomationProperties.Name="Read-only Lua script preview" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SmallText}" VerticalAlignment="Center"
                           Text="No action is taken on the file by this app." />
                <Button Grid.Column="1" Content="Open File Location" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="OpenLocation_Click" />
                <Button Grid.Column="2" Content="Close" Style="{StaticResource PrimaryButton}" Click="Close_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>



