<Window x:Class="WtxPcCheck.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WTX PC CHECK"
        Width="580" SizeToContent="Height" MaxHeight="620"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Background="{StaticResource BgElevatedBrush}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBorder" Width="36" Height="36" CornerRadius="8" Background="#173033" BorderBrush="#275854" BorderThickness="1">
                    <Path x:Name="IconPath" Data="M12,3 L21,20 H3 Z M12,9 V14 M12,17 V17.1" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Margin="8" />
                </Border>
                <TextBlock x:Name="TitleText" Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center"
                           FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <Button Grid.Column="2" Style="{StaticResource DangerCloseButton}" Click="Secondary_Click" ToolTip="Close" AutomationProperties.Name="Close dialog">
                    <Path Data="M4,4 L14,14 M14,4 L4,14" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="17" Height="17" Stretch="Uniform" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" MaxHeight="410" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="MessageText" Style="{StaticResource BodyText}" FontSize="13.5" TextWrapping="Wrap" Margin="0,0,6,0" />
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="SecondaryButton" Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="Secondary_Click" />
                <Button x:Name="PrimaryButton" Content="OK" Style="{StaticResource PrimaryButton}" Click="Primary_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
