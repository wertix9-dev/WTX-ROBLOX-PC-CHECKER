<Window x:Class="WtxPcCheck.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WTX PC CHECK"
        Width="620" Height="390"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Background="{StaticResource BgElevatedBrush}">
        <Grid>
            <Grid.Background>
                <RadialGradientBrush Center="0.15,0.05" GradientOrigin="0.15,0.05" RadiusX="0.9" RadiusY="1.1">
                    <GradientStop Color="#1A2B31" Offset="0" />
                    <GradientStop Color="#131A1F" Offset="0.55" />
                    <GradientStop Color="#10161A" Offset="1" />
                </RadialGradientBrush>
            </Grid.Background>

            <Grid Margin="40,34,40,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="170" Height="170" Margin="4,0,34,0">
                        <Ellipse Width="170" Height="170" Stroke="#22313A" StrokeThickness="7" />
                        <Ellipse x:Name="OuterArc" Width="170" Height="170" Stroke="{StaticResource AccentBrush}" StrokeThickness="7" StrokeDashArray="42 130" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="RingRotate" Angle="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="InnerArc" Width="138" Height="138" Stroke="{StaticResource LimeBrush}" StrokeThickness="2" StrokeDashArray="18 110" Opacity="0.55" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="InnerRingRotate" Angle="120" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Border Width="86" Height="86" CornerRadius="20" Background="#122126" BorderBrush="#2C5A57" BorderThickness="1">
                            <Path Data="M12,2 L20,5 V11 C20,16 16.5,20 12,22 C7.5,20 4,16 4,11 V5 Z M7,12 L10.5,15.5 L17,8.5"
                                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Margin="24" />
                        </Border>
                    </Grid>

                    <StackPanel VerticalAlignment="Center" Width="310">
                        <TextBlock Text="WTX PC CHECK" FontFamily="{StaticResource DisplayFont}" FontSize="38" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="Made by WERTIX" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="Defensive PC check · Local scan · No telemetry" Style="{StaticResource SmallText}" Margin="0,12,0,0" />
                        <Border Height="2" Width="52" Background="{StaticResource AccentGradient}" HorizontalAlignment="Left" Margin="0,20,0,18" CornerRadius="1" />
                        <TextBlock x:Name="StatusText" Text="Starting…" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailText" Style="{StaticResource SmallText}" Margin="0,6,0,0" Text="Preparing the local app. No scan starts automatically." />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="Privacy first: settings are loaded locally, and scan results are never saved." Style="{StaticResource SmallText}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,12,0,0" />
                <TextBlock Grid.Row="2" Text="Windows 10 22H2 · Windows 11 · x64" Style="{StaticResource LabelText}" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </Grid>
        </Grid>
    </Border>
</Window>
