<Window x:Class="WtxPcCheck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="WTX PC CHECK"
        Width="1280" Height="840" MinWidth="880" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Icon="Assets/AppIcon.ico"
        Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#26333C" BorderThickness="1" Background="{StaticResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#11181D" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="18,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="Transparent">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="7" Background="#16282C" BorderBrush="#275854" BorderThickness="1">
                                <Path Data="M12,2 L20,5 V11 C20,16 16.5,20 12,22 C7.5,20 4,16 4,11 V5 Z M8,12 L11,15 L16,9" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Margin="7" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="WTX PC CHECK" FontFamily="{StaticResource DisplayFont}" FontSize="14.5" FontWeight="SemiBold" />
                                <TextBlock Text="Made by WERTIX" Style="{StaticResource SmallText}" FontSize="10.5" Margin="0,-1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Style="{StaticResource Badge}" Background="#142326" BorderBrush="#244641" BorderThickness="1" Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource LimeBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Local-only scan" Style="{StaticResource SmallText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize window" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="M4,9 H16" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform" />
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Click="Maximize_Click" ToolTip="Maximize" AutomationProperties.Name="Maximize or restore window" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path x:Name="MaximizeGlyph" Data="M4,4 H16 V16 H4 Z" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Width="17" Height="17" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource DangerCloseButton}" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close window" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Data="M4,4 L16,16 M16,4 L4,16" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Width="17" Height="17" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="216" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#11181D" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,1,0">
                    <Grid Margin="14,20,14,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="8,0,8,18">
                            <TextBlock Text="WORKSPACE" Style="{StaticResource LabelText}" Margin="2,0,0,8" />
                            <ListBox Style="{StaticResource NavListBox}"
                                     ItemsSource="{Binding NavigationItems}"
                                     SelectedValue="{Binding CurrentPageKey, Mode=TwoWay}"
                                     SelectedValuePath="Key"
                                     AutomationProperties.Name="Main navigation">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Path Data="{Binding IconData}" Width="17" Height="17" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="4,0,4,0">
                            <Border Style="{StaticResource Divider}" Margin="0,0,0,14" />
                            <Border Background="#142027" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="9" Padding="12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M12,2 L20,5 V11 C20,16 16.5,20 12,22 C7.5,20 4,16 4,11 V5 Z" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.4" Stretch="Uniform" Width="16" Height="18" VerticalAlignment="Center" />
                                        <TextBlock Text="WTX PC CHECK" FontWeight="SemiBold" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Made by WERTIX" Style="{StaticResource SmallText}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource SmallText}" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0" />
                                    <Border Background="#101A1E" CornerRadius="5" Padding="7,4" Margin="0,9,0,0">
                                        <TextBlock Text="No telemetry  |  No scan history" Style="{StaticResource SmallText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#221F15" BorderBrush="#4A3C1F" BorderThickness="1" CornerRadius="8" Margin="28,14,28,0" Padding="14,10"
                            Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Data="M12,3 L21,20 H3 Z M12,9 V14 M12,17 V17.1" Stroke="{StaticResource AmberBrush}" StrokeThickness="1.4" Stretch="Uniform" Width="17" Height="17" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding NoticeText}" Style="{StaticResource SmallText}" Foreground="#E7D6B4" Margin="10,0,10,0" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="6" Command="{Binding DismissNoticeCommand}" ToolTip="Dismiss notice" AutomationProperties.Name="Dismiss notice">
                                <Path Data="M4,4 L12,12 M12,4 L4,12" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" />
                            </Button>
                        </Grid>
                    </Border>

                    <Grid x:Name="PageHost" Grid.Row="1">
                        <!-- DASHBOARD -->
                        <ScrollViewer x:Name="DashboardScrollViewer" Style="{StaticResource PageScroll}" Visibility="{Binding IsDashboardPage, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel MaxWidth="1180" HorizontalAlignment="Stretch" Margin="28,24,28,32">
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />
                                        <TextBlock Text="{Binding CurrentPageSubtitle}" Style="{StaticResource BodyText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource Badge}" Background="#152126" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" Padding="10,5" VerticalAlignment="Top">
                                        <TextBlock Text="Windows 10 22H2  |  Windows 11  |  x64" Style="{StaticResource SmallText}" FontSize="10.5" />
                                    </Border>
                                </Grid>

                                <Border CornerRadius="14" BorderThickness="1" BorderBrush="#2B4148" Background="{StaticResource HeroGradient}" Padding="30">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="230" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                            <TextBlock Text="WERTIX  |  LOCAL PC CHECK" Style="{StaticResource LabelText}" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="A clearer look at this PC" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,8" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource BodyText}" MaxWidth="660" HorizontalAlignment="Left"
                                                       Text="Review selected drives for Roblox executor indicators, Lua script risk signals, and basic Windows security gaps. Every check runs on this PC. Indicators are explained, never presented as proof." />
                                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartFullScanSetupCommand}" Padding="18,10" Margin="0,0,10,0" AutomationProperties.Name="Start Full PC Scan" ToolTip="Opens the Full PC Check profile so you can review categories and locations before scanning.">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="M3,3 H21 V21 H3 Z M7,7 H10 V10 H7 Z M14,7 H17 V10 H14 Z M7,14 H10 V17 H7 Z M14,14 H17 V17 H14 Z" Stroke="{StaticResource DarkTextBrush}" StrokeThickness="1.4" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                                                        <TextBlock Text="Start Scan" Foreground="{StaticResource DarkTextBrush}" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding NavigateScanCommand}" Content="Change scope" />
                                            </StackPanel>
                                            <WrapPanel Margin="0,16,0,0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                    <TextBlock Text="{Binding SelectedScopeSummary}" Style="{StaticResource SmallText}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="A confirmation appears before every scan." Style="{StaticResource SmallText}" VerticalAlignment="Center" />
                                            </WrapPanel>
                                        </StackPanel>

                                        <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="200" Height="200">
                                            <Ellipse Width="184" Height="184" Stroke="#2B4650" StrokeThickness="1" />
                                            <Ellipse Width="150" Height="150" Stroke="#2F6B66" StrokeThickness="1" StrokeDashArray="4 6" />
                                            <Path Data="M12,2 L20,5 V11 C20,16 16.5,20 12,22 C7.5,20 4,16 4,11 V5 Z" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.4" Stretch="Uniform" Width="104" Height="126" Opacity="0.85" />
                                            <Path Data="M7,12 L10.5,15.5 L17,8.5" Stroke="{StaticResource LimeBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="34" Height="34" Margin="0,10,0,0" />
                                            <TextBlock Text="LOCAL" Style="{StaticResource LabelText}" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.55*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="PC status" Style="{StaticResource CardTitle}" />
                                                    <Border Grid.Column="1" Style="{StaticResource Badge}" Background="{Binding PcStatusTone, Converter={StaticResource ToneToBrush}, ConverterParameter=soft}" BorderBrush="{Binding PcStatusTone, Converter={StaticResource ToneToBrush}}" BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="6" Height="6" Fill="{Binding PcStatusTone, Converter={StaticResource ToneToBrush}}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding ScanStatusLabel}" FontSize="10.5" Foreground="{Binding PcStatusTone, Converter={StaticResource ToneToBrush}}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding PcStatusLabel}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" Margin="0,12,0,4" />
                                                <TextBlock Text="{Binding PcStatusDetail}" Style="{StaticResource BodyText}" />
                                                <TextBlock Text="{Binding SelectedRootsDisplay}" Style="{StaticResource SmallText}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedRootsDisplay}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                                    <Button Content="Open scan" Style="{StaticResource SecondaryButton}" Command="{Binding NavigateScanCommand}" Margin="0,0,8,0" />
                                                    <Button Content="Close results" Style="{StaticResource GhostButton}" Command="{Binding CloseResultsCommand}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,14,0,0" Visibility="{Binding ShowScanMetrics, Converter={StaticResource BoolToVisibility}}">
                                                    <Border Style="{StaticResource Divider}" Margin="0,0,0,10" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding FilesCheckedText}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <TextBlock Text=" files checked   |   " Style="{StaticResource SmallText}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding FindingCountText}" FontWeight="SemiBold" Foreground="{StaticResource AmberBrush}" />
                                                        <TextBlock Text=" items   |   " Style="{StaticResource SmallText}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding InaccessibleCountText}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <TextBlock Text=" inaccessible" Style="{StaticResource SmallText}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding HasScanOutcome, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Results in this session" Style="{StaticResource CardTitle}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding LastScanText}" Style="{StaticResource SmallText}" VerticalAlignment="Center" />
                                                </Grid>
                                                <Grid Margin="0,14,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FilesCheckedText}" FontSize="20" FontWeight="SemiBold" />
                                                        <TextBlock Text="FILES CHECKED" Style="{StaticResource LabelText}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding HighCountText}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource RedBrush}" />
                                                        <TextBlock Text="HIGH" Style="{StaticResource LabelText}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{Binding MediumCountText}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AmberBrush}" />
                                                        <TextBlock Text="MEDIUM" Style="{StaticResource LabelText}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3">
                                                        <TextBlock Text="{Binding InaccessibleCountText}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <TextBlock Text="INACCESSIBLE" Style="{StaticResource LabelText}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="{Binding ScanSummaryText}" Style="{StaticResource SmallText}" Margin="0,12,0,0" />
                                                <Button Content="Review findings" Style="{StaticResource TextLinkButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding NavigateScanCommand}" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                            <Expander Tag="What gets scanned?">
                                                <Expander.Header>
                                                    <TextBlock Text="What gets scanned?" Style="{StaticResource CardTitle}" />
                                                </Expander.Header>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,12"
                                                               Text="WTX PC CHECK inspects only the locations you select, including subfolders, hidden files, and system files where Windows permits access. Profiles can combine Roblox, Minecraft, and Windows security checks." />
                                                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,8" Text="-  Executable and library names, locations, signatures, Roblox proxy-DLL patterns, and optional local hash indicators." />
                                                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,8" Text="-  Minecraft .jar archives inspected as ZIP metadata and selected text entries. No extraction, execution, or permanent unpacking." />
                                                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,8" Text="-  .lua and .luau scripts reviewed as static text. Scripts are not automatically executors or malware." />
                                                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,8" Text="-  Basic Windows security status, startup entries, a read-only running-process snapshot, and an optional Defender scan." />
                                                    <TextBlock Style="{StaticResource SmallText}" Margin="0,10,0,0"
                                                               Text="Not scanned: locations you did not select, cloud-only placeholders, reparse-point folders, protected areas Windows blocks, locked files, and archives beyond the size, entry, or metadata limits. Unknown mods are not automatically malicious. Detection is not perfect." />
                                                </StackPanel>
                                            </Expander>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Updates" Style="{StaticResource CardTitle}" />
                                                    <Border Grid.Column="1" Style="{StaticResource Badge}" Background="{Binding UpdateTone, Converter={StaticResource ToneToBrush}, ConverterParameter=soft}" BorderBrush="{Binding UpdateTone, Converter={StaticResource ToneToBrush}}" BorderThickness="1">
                                                        <TextBlock Text="{Binding UpdateStateLabel}" FontSize="10.5" Foreground="{Binding UpdateTone, Converter={StaticResource ToneToBrush}}" FontWeight="SemiBold" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding UpdateMessage}" Style="{StaticResource BodyText}" Margin="0,10,0,0" />
                                                <TextBlock Text="{Binding UpdateLatestVersionText}" Style="{StaticResource SmallText}" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" Visibility="{Binding UpdateLatestVersionText, Converter={StaticResource StringToVisibility}}" />
                                                <StackPanel Margin="0,12,0,0" Visibility="{Binding UpdateShowProgress, Converter={StaticResource BoolToVisibility}}">
                                                    <ProgressBar Value="{Binding UpdateProgressPercent, Mode=OneWay}" Maximum="100" />
                                                    <TextBlock Text="{Binding UpdateProgressText}" Style="{StaticResource SmallText}" Margin="0,5,0,0" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                    <Button Content="Check now" Style="{StaticResource SecondaryButton}" Command="{Binding CheckUpdatesCommand}" Padding="12,7" Visibility="{Binding CanInstallUpdate, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                                    <Button Content="Restart and install" Style="{StaticResource PrimaryButton}" Command="{Binding InstallUpdateCommand}" Padding="12,7" Visibility="{Binding CanInstallUpdate, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding LastUpdateCheckText}" Style="{StaticResource SmallText}" Margin="0,9,0,0" />
                                                <Border Style="{StaticResource Divider}" Margin="0,12" />
                                                <WrapPanel>
                                                    <TextBlock Text="Automatic updates" Style="{StaticResource SmallText}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding AutomaticUpdatesText}" Style="{StaticResource SmallText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <Button Content="Settings" Style="{StaticResource TextLinkButton}" Command="{Binding NavigateSettingsCommand}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Windows security" Style="{StaticResource CardTitle}" />
                                                    <Border Grid.Column="1" Style="{StaticResource Badge}" Background="{Binding SecurityTone, Converter={StaticResource ToneToBrush}, ConverterParameter=soft}" BorderBrush="{Binding SecurityTone, Converter={StaticResource ToneToBrush}}" BorderThickness="1">
                                                        <TextBlock Text="{Binding SecurityStateLabel}" FontSize="10.5" Foreground="{Binding SecurityTone, Converter={StaticResource ToneToBrush}}" FontWeight="SemiBold" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding SecurityCheckedText}" Style="{StaticResource SmallText}" Margin="0,7,0,10" />
                                                <Grid Margin="0,0,0,9">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Windows &amp; Defender" Style="{StaticResource LabelText}" />
                                                        <TextBlock Text="{Binding DefenderStatusText}" Style="{StaticResource BodyText}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding RefreshSecurityCommand}" Padding="8,4" />
                                                </Grid>
                                                <TextBlock Text="{Binding DefenderDetailText}" Style="{StaticResource SmallText}" Margin="0,0,0,10" />
                                                <Border Style="{StaticResource Divider}" Margin="0,0,0,10" />
                                                <TextBlock Text="Firewall" Style="{StaticResource LabelText}" />
                                                <TextBlock Text="{Binding FirewallStatusText}" Style="{StaticResource BodyText}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,2" />
                                                <TextBlock Text="{Binding FirewallDetailText}" Style="{StaticResource SmallText}" Margin="0,0,0,10" />
                                                <TextBlock Text="Windows Update" Style="{StaticResource LabelText}" />
                                                <TextBlock Text="{Binding UpdatesStatusText}" Style="{StaticResource BodyText}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,2" />
                                                <TextBlock Text="{Binding UpdatesDetailText}" Style="{StaticResource SmallText}" Margin="0,0,0,8" />
                                                <TextBlock Text="{Binding RegisteredAntivirusText}" Style="{StaticResource SmallText}" Margin="0,4,0,4" />
                                                <TextBlock Text="{Binding ProcessSummaryText}" Style="{StaticResource SmallText}" Margin="0,0,0,10" />
                                                <StackPanel>
                                                    <Button Content="Security details" Style="{StaticResource TextLinkButton}" HorizontalAlignment="Left" Command="{Binding NavigateScanCommand}" />
                                                    <Button Content="Open Windows Security" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Command="{Binding OpenWindowsSecurityCommand}" Padding="8,4" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="These checks are separate from file findings and do not replace Windows Security." Style="{StaticResource SmallText}" Margin="0,10,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Style="{StaticResource SmallText}" Margin="0,20,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                                           Text="WTX PC CHECK  |  Made by WERTIX  |  Scans stay on this PC  |  No results are saved after you close them or exit the app." />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- SCAN -->
                        <ScrollViewer x:Name="ScanScrollViewer" Style="{StaticResource PageScroll}" Visibility="{Binding IsScanPage, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel MaxWidth="1180" HorizontalAlignment="Stretch" Margin="28,24,28,32">
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding CurrentPageTitle}" Style="{StaticResource PageTitle}" />
