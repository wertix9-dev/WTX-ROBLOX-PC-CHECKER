                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Refresh locations" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshDrivesCommand}" VerticalAlignment="Top" />
                                </Grid>

                                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Scan profile" Style="{StaticResource CardTitle}" />
